<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Audio -->
    <PackageVersion Include="NAudio" Version="2.2.1" />
    <!-- MVVM -->
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- System Tray -->
    <PackageVersion Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <!-- UIAutomation -->
    <PackageVersion Include="FlaUI.Core" Version="4.0.0" />
    <PackageVersion Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- Local ASR. 1.13.2 provides OnlineRecognizer Paraformer and
         OfflinePunctuation bindings used by the bundled int8 models. -->
    <PackageVersion Include="org.k2fsa.sherpa.onnx" Version="1.13.2" />
    <!-- Provider-independent personal-term semantic scoring. Use only the
         managed binding so sherpa-onnx remains the single source of the aligned
         1.24.4 native DLL in Windows publish output. -->
    <PackageVersion Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.24.4" />
    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <!-- Testing -->
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Installer -->
    <PackageVersion Include="WixToolset.UI.wixext" Version="5.0.0" />
  </ItemGroup>
</Project>
