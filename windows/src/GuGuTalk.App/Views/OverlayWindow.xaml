<Window x:Class="GuGuTalk.App.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GuGuTalk.App.Views.Controls"
        Title="GuGuTalk Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        Width="126" Height="40"
        WindowStartupLocation="Manual">

    <Border x:Name="RootBorder"
            CornerRadius="23"
            Background="{StaticResource OverlayActiveBrush}"
            ClipToBounds="True">

        <Grid x:Name="ContentRoot">

            <!-- State: Recording (no transcript yet) -->
            <Grid x:Name="RecordingEmptyContent"
                  Visibility="Collapsed">
                <controls:WaveformMeter x:Name="WaveformEmpty"
                                        BarBrush="{StaticResource OverlayTextBrush}"
                                        BarCount="10"
                                        Compact="True" />
            </Grid>

            <!-- State: Recording with transcript -->
            <Grid x:Name="RecordingTranscriptContent"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Name="TranscriptText"
                           Margin="20,12,8,12"
                           FontSize="14.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OverlayTextBrush}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxHeight="80"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <BlurEffect x:Name="TranscriptBlur" Radius="0" />
                    </TextBlock.Effect>
                </TextBlock>
                <controls:WaveformMeter Grid.Column="1"
                                        x:Name="WaveformInline"
                                        Width="44" Height="32"
                                        Margin="0,0,16,0"
                                        Opacity="0.7"
                                        BarBrush="{StaticResource OverlayTextBrush}"
                                        BarCount="6"
                                        Compact="True"
                                        VerticalAlignment="Center" />
            </Grid>

            <!-- State: Post-processing -->
            <StackPanel x:Name="PostProcessingContent"
                        Visibility="Collapsed"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Grid Width="14" Height="14"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <Ellipse Stroke="{StaticResource OverlayTextSubtleBrush}"
                             StrokeThickness="2"
                             Opacity="0.4" />
                    <Ellipse Stroke="{StaticResource OverlayTextBrush}"
                             StrokeThickness="2"
                             StrokeDashArray="2 6"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock Text="处理中"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource OverlayTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- State: Error -->
            <TextBlock x:Name="ErrorContent"
                       Visibility="Collapsed"
                       Padding="16,10"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource OverlayDangerBrush}"
                       TextWrapping="Wrap"
                       MaxHeight="50"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />

            <!-- State: Hint message -->
            <TextBlock x:Name="HintContent"
                       Visibility="Collapsed"
                       Padding="13,8"
                       FontSize="12.5"
                       Foreground="{StaticResource OverlayTextBrush}"
                       Opacity="0.85"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center" />

        </Grid>
    </Border>
</Window>
