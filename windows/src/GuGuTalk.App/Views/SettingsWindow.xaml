<Window x:Class="GuGuTalk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GuGuTalk 设置"
        Width="720" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="640" MinHeight="480"
        Background="{StaticResource SurfacePaperBrush}"
        Loaded="OnLoaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="186" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="{StaticResource AquaSoftBrush}" Padding="14,16">
            <DockPanel>

                <!-- Brand header -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,0,18">
                    <Border Width="28" Height="28" CornerRadius="7"
                            Background="White"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1">
                        <Image Source="/Assets/app-icon.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="GuGuTalk" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="设置" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="NavList" SelectedIndex="0" BorderThickness="0"
                         Background="Transparent"
                         ItemContainerStyle="{StaticResource SidebarNavItem}"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBoxItem Content="通用" />
                    <ListBoxItem Content="输入引擎" />
                    <ListBoxItem Content="热键" />
                    <ListBoxItem Content="后处理" />
                    <ListBoxItem Content="权限" />
                    <ListBoxItem Content="关于" />
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Column="1" Padding="32,28" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ContentPanel">
                <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,18" />

                <!-- General Page -->
                <StackPanel x:Name="GeneralPage">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="识别模式" />
                            <ComboBox x:Name="ModeCombo" Width="220" Height="32"
                                      HorizontalAlignment="Left" Margin="0,0,0,8">
                                <ComboBoxItem Content="本地 (sherpa-onnx)" />
                                <ComboBoxItem Content="豆包" />
                                <ComboBoxItem Content="千问" />
                            </ComboBox>
                            <TextBlock Text="选择音频转文字使用的识别引擎。本地模式离线可用。"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="外观" />
                            <CheckBox x:Name="FollowSystemTheme" Content="跟随系统主题" IsChecked="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Provider Page -->
                <StackPanel x:Name="ProviderPage" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="豆包配置" />
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="App ID" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DoubaoAppId"
                                         Style="{StaticResource SettingsTextBox}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Access Key" />
                                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="DoubaoAccessKey"
                                             Style="{StaticResource SettingsPasswordBox}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Resource ID" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="DoubaoResourceId"
                                         Style="{StaticResource SettingsTextBox}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Endpoint" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="DoubaoEndpoint"
                                         Style="{StaticResource SettingsTextBox}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="千问配置" />
                            <Grid Margin="0,4,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="API Key" />
                                <PasswordBox Grid.Row="0" Grid.Column="1" x:Name="QwenApiKey"
                                             Style="{StaticResource SettingsPasswordBox}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Model" />
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="QwenModel"
                                         Style="{StaticResource SettingsTextBox}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource FieldLabel}" Text="Endpoint" />
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="QwenEndpoint"
                                         Style="{StaticResource SettingsTextBox}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Hotkey Page -->
                <StackPanel x:Name="HotkeyPage" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="按住说话" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="HoldEnabled" Content="启用"
                                          IsChecked="True" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="HoldHotkeyButton"
                                        Style="{StaticResource HotkeyBadgeButton}"
                                        MinWidth="120" Click="HoldHotkey_Click">
                                    <TextBlock x:Name="HoldHotkeyDisplay" Text="Ctrl+`" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="切换模式" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" x:Name="ToggleEnabled" Content="启用"
                                          IsChecked="True" VerticalAlignment="Center" />
                                <Button Grid.Column="1" x:Name="ToggleHotkeyButton"
                                        Style="{StaticResource HotkeyBadgeButton}"
                                        MinWidth="120" Click="ToggleHotkey_Click">
                                    <TextBlock x:Name="ToggleHotkeyDisplay" Text="Alt+Space" />
                                </Button>
                            </Grid>
                            <TextBlock Text="点击右侧热键标签可重新录制，按 Esc 取消。"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Post-processing Page -->
                <StackPanel x:Name="PostProcessPage" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="LLM 后处理" />
                            <CheckBox x:Name="PostProcessEnabled" Content="启用智能改写" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="标点模式" />
                            <ComboBox x:Name="PunctuationCombo" Width="220" Height="32"
                                      HorizontalAlignment="Left">
                                <ComboBoxItem Content="智能保留" />
                                <ComboBoxItem Content="去掉标点" />
                                <ComboBoxItem Content="空格代替" />
                                <ComboBoxItem Content="去掉句尾句号" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="热词替换" />
                            <DataGrid x:Name="HotwordGrid" AutoGenerateColumns="False"
                                      CanUserAddRows="True" Height="180" Margin="0,4,0,0"
                                      BorderBrush="{StaticResource BorderSubtleBrush}"
                                      BorderThickness="1"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{StaticResource BorderSubtleBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="原词" Binding="{Binding Pattern}" Width="*" />
                                    <DataGridTextColumn Header="替换为" Binding="{Binding Replacement}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Permissions Page -->
                <StackPanel x:Name="PermissionsPage" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="权限状态"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="PermissionsSummary"
                                               FontSize="11.5"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" x:Name="PermissionsRefreshButton"
                                        Style="{StaticResource HotkeyBadgeButton}"
                                        Padding="12,6"
                                        Content="刷新"
                                        Click="PermissionsRefresh_Click" />
                            </Grid>

                            <!-- Microphone -->
                            <Border CornerRadius="9"
                                    Background="{StaticResource SurfacePaperBrush}"
                                    Padding="14,12"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             Margin="0,2,12,0"
                                             VerticalAlignment="Top"
                                             x:Name="MicStatusDot"
                                             Fill="{StaticResource SignalAmberBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="麦克风"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="MicStatusDescription"
                                                   Text="正在检查麦克风权限..."
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="MicSettingsButton"
                                            Style="{StaticResource HotkeyBadgeButton}"
                                            Padding="10,5"
                                            Content="打开系统设置"
                                            VerticalAlignment="Top"
                                            Click="OpenMicrophoneSettings_Click" />
                                </Grid>
                            </Border>

                            <!-- Keyboard Hook -->
                            <Border CornerRadius="9"
                                    Background="{StaticResource SurfacePaperBrush}"
                                    Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="10" Height="10"
                                             Margin="0,2,12,0"
                                             VerticalAlignment="Top"
                                             x:Name="HookStatusDot"
                                             Fill="{StaticResource SignalAmberBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="全局热键"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock x:Name="HookStatusDescription"
                                                   Text="正在检查热键权限..."
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About Page -->
                <StackPanel x:Name="AboutPage" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Width="44" Height="44" CornerRadius="10"
                                        Background="White"
                                        BorderBrush="{StaticResource BorderSubtleBrush}"
                                        BorderThickness="1">
                                    <Image Source="/Assets/app-icon.png" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="GuGuTalk for Windows" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="版本 1.0.0"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <TextBlock TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,8">
                                一款 Windows 原生语音输入工具，支持本地识别和云端识别。
                            </TextBlock>
                            <TextBlock FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}">
                                C# / .NET 8 / WPF / NAudio / sherpa-onnx
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
