<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>GuGuTalk.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BundledModelsDir>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', 'GuGuTalk.LocalAsr', 'bundled-models'))</BundledModelsDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup Condition="Exists('Assets\app-icon.ico')">
    <Content Include="Assets\app-icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <PropertyGroup Condition="Exists('Assets\app-icon.ico')">
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Brand image referenced by XAML (tray panel + settings header) must be a
       WPF resource so pack:// URIs like /Assets/app-icon.png resolve at runtime. -->
  <ItemGroup Condition="Exists('Assets\app-icon.png')">
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuGuTalk.Core\GuGuTalk.Core.csproj" />
    <ProjectReference Include="..\GuGuTalk.LocalAsr\GuGuTalk.LocalAsr.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- The LocalAsr project downloads the model during its build. Collect files
       in targets so a clean first build does not miss them during evaluation. -->
  <Target Name="CopyBundledAsrModelsToOutput" AfterTargets="Build">
    <ItemGroup>
      <_BundledAsrModel Include="$(BundledModelsDir)/**/*.onnx;$(BundledModelsDir)/**/*.txt;$(BundledModelsDir)/**/*.dict;$(BundledModelsDir)/**/LICENSE;$(BundledModelsDir)/**/PINYIN_LICENSE;$(BundledModelsDir)/**/CMUDICT_LICENSE" />
    </ItemGroup>
    <Copy SourceFiles="@(_BundledAsrModel)"
          DestinationFiles="@(_BundledAsrModel->'$(OutDir)models\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledAsrModelsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PublishBundledAsrModel Include="$(BundledModelsDir)/**/*.onnx;$(BundledModelsDir)/**/*.txt;$(BundledModelsDir)/**/*.dict;$(BundledModelsDir)/**/LICENSE;$(BundledModelsDir)/**/PINYIN_LICENSE;$(BundledModelsDir)/**/CMUDICT_LICENSE" />
    </ItemGroup>
    <Copy SourceFiles="@(_PublishBundledAsrModel)"
          DestinationFiles="@(_PublishBundledAsrModel->'$(PublishDir)models\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
