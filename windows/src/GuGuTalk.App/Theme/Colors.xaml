<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand Colors (from DESIGN.md Aqua Chick Companion) -->
    <Color x:Key="IconAquaColor">#29B8C7</Color>
    <Color x:Key="DeepAquaColor">#0A7887</Color>
    <Color x:Key="AquaSoftColor">#D4F7FA</Color>
    <Color x:Key="IconOrangeColor">#F28C38</Color>
    <Color x:Key="ReadyGreenColor">#159B70</Color>
    <Color x:Key="SignalAmberColor">#D16E1A</Color>
    <Color x:Key="DangerRedColor">#D62E2E</Color>

    <!-- Neutral Colors -->
    <Color x:Key="TextPrimaryColor">#142226</Color>
    <Color x:Key="TextSecondaryColor">#506B6E</Color>
    <Color x:Key="BorderSubtleColor">#A0C7CC</Color>
    <Color x:Key="SurfacePaperColor">#F1FAFA</Color>
    <Color x:Key="SurfacePanelColor">#FFFCF5</Color>

    <!-- Dark Mode -->
    <Color x:Key="SurfaceDarkColor">#0E1314</Color>
    <Color x:Key="SurfacePanelDarkColor">#1A2526</Color>

    <!-- Overlay (top-center bubble) -->
    <Color x:Key="OverlayActiveColor">#1FA3B5</Color>
    <Color x:Key="OverlayActiveDarkColor">#0F4F58</Color>
    <Color x:Key="OverlayTextColor">#F4FCFD</Color>
    <Color x:Key="OverlayTextSubtleColor">#C7E9ED</Color>
    <Color x:Key="OverlayDangerColor">#FF8A82</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="IconAquaBrush" Color="{StaticResource IconAquaColor}" />
    <SolidColorBrush x:Key="DeepAquaBrush" Color="{StaticResource DeepAquaColor}" />
    <SolidColorBrush x:Key="AquaSoftBrush" Color="{StaticResource AquaSoftColor}" />
    <SolidColorBrush x:Key="IconOrangeBrush" Color="{StaticResource IconOrangeColor}" />
    <SolidColorBrush x:Key="ReadyGreenBrush" Color="{StaticResource ReadyGreenColor}" />
    <SolidColorBrush x:Key="SignalAmberBrush" Color="{StaticResource SignalAmberColor}" />
    <SolidColorBrush x:Key="DangerRedBrush" Color="{StaticResource DangerRedColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="SurfacePaperBrush" Color="{StaticResource SurfacePaperColor}" />
    <SolidColorBrush x:Key="SurfacePanelBrush" Color="{StaticResource SurfacePanelColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="OverlayActiveBrush" Color="{StaticResource OverlayActiveColor}" />
    <SolidColorBrush x:Key="OverlayTextBrush" Color="{StaticResource OverlayTextColor}" />
    <SolidColorBrush x:Key="OverlayTextSubtleBrush" Color="{StaticResource OverlayTextSubtleColor}" />
    <SolidColorBrush x:Key="OverlayDangerBrush" Color="{StaticResource OverlayDangerColor}" />

</ResourceDictionary>
