<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GuGuTalk.LocalAsr</RootNamespace>
    <ModelName>sherpa-onnx-sense-voice-zh-en-ja-ko-yue-int8-2024-07-17</ModelName>
    <ModelArchive>$(ModelName).tar.bz2</ModelArchive>
    <ModelUrl>https://github.com/k2-fsa/sherpa-onnx/releases/download/asr-models/$(ModelArchive)</ModelUrl>
    <ModelCacheDir>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', '..', '.modelcache'))</ModelCacheDir>
    <BundledModelsRoot>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', 'bundled-models'))</BundledModelsRoot>
    <ModelOutputDir>$([System.IO.Path]::Combine('$(BundledModelsRoot)', '$(ModelName)'))</ModelOutputDir>
    <ModelTokensPath>$([System.IO.Path]::Combine('$(ModelOutputDir)', 'tokens.txt'))</ModelTokensPath>
    <SkipAsrModelDownload>false</SkipAsrModelDownload>
    <PowerShellExe Condition="'$(PowerShellExe)' == '' And '$(OS)' == 'Windows_NT'">powershell</PowerShellExe>
    <PowerShellExe Condition="'$(PowerShellExe)' == ''">pwsh</PowerShellExe>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GuGuTalk.Core\GuGuTalk.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="org.k2fsa.sherpa.onnx" />
  </ItemGroup>

  <!--
    Model files are referenced from GuGuTalk.App.csproj directly (via <Content> +
    BundledModelsDir property), so they end up in the App's output and publish
    directories. We only download/extract them here.
  -->

  <Target Name="DownloadAsrModel"
          BeforeTargets="BeforeBuild"
          Condition="'$(SkipAsrModelDownload)' != 'true' And !Exists('$(ModelTokensPath)')">
    <Exec Command="$(PowerShellExe) -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)download-model.ps1&quot; -ModelName &quot;$(ModelName)&quot; -ModelUrl &quot;$(ModelUrl)&quot; -CacheDir &quot;$(ModelCacheDir)&quot; -OutDir &quot;$(BundledModelsRoot)&quot;"
          WorkingDirectory="$(MSBuildThisFileDirectory)" />

    <Error Text="Model extraction failed: tokens.txt not found at $(ModelOutputDir)"
           Condition="!Exists('$(ModelTokensPath)')" />
  </Target>

  <Target Name="CleanBundledModels" AfterTargets="Clean">
    <RemoveDir Directories="$(BundledModelsRoot)" />
  </Target>
</Project>
